#include <stdio.h>

int main()
{
	int character_limit= 100; // The limit can be freely changed
	char string_input[character_limit];

    /* I had problems with garbage data when the input was
    shorter than the charater limit. The solution I found
    is to first fill the string with null charaters */
	for(int i=0; i!=character_limit; i++){
	    string_input[i] = 0;
	}

	printf("Type your word (maximum length of %i characters):", character_limit);
	scanf("%[^\n]s", string_input);

	for(int i=character_limit-1; i!=-1; i--) {
	    if(string_input[i] >= 0){ // The if statement gets rid of the null characters
	        printf("%c", string_input[i]);
	    }
	}

	return 0;
}
