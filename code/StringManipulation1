#include <stdio.h>

int main()
{
    int character_limit= 9;
    char string_input[character_limit];
    
    printf("Type your word (maximum length of %i characters):", character_limit+1);
    scanf("%[^\n]s", string_input);
    
    for(int i=character_limit; i!=-1; i--){
        printf("%c", string_input[i]);
    }
    
    return 0;
}
